# Copy to .env.local: `cp .env.example .env.local`
#
# The two Supabase values below are placeholders. They are enough
# for the editor, the preview and the PDF export; without them the
# app does not start. Replace them with a real project to sign in.

# --- Browser (inlined into the bundle; public by design) ---------
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_PUBLISHABLE_KEY=placeholder-publishable-key
# Analytics; only initialised in production builds.
VITE_POSTHOG_KEY=
# Blog content; only the /blog routes need it.
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production

# --- Netlify functions (secrets; served by `npx netlify dev`) ----
# Supabase admin access for the AI jobs, checkout and account deletion.
SUPABASE_SERVICE_ROLE_KEY=
# Pass checkout. Prices are looked up by the keys pro_1_days,
# pro_7_days and pro_30_days in your Stripe account.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional second signing secret, for a second webhook endpoint.
# STRIPE_WEBHOOK_SECRET_KIWICV=
# AI features (Vertex AI / Gemini): a service-account key as JSON.
# The signed-in profile also needs an active Pass.
GOOGLE_SERVICE_ACCOUNT_KEY=
# Optional; falls back to project_id inside the service-account key.
GOOGLE_PROJECT_ID=
# Google Drive backup: the OAuth client configured as Supabase's
# Google provider (it issues the refresh token).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Test-only: lets `netlify dev` answer AI requests that ask for mock output.
# AI_ALLOW_MOCK=true
