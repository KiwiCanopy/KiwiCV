{
  "name": "kiwicv",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "5.0.1",
  "type": "module",
  "scripts": {
    "preinstall": "node scripts/check-node-version.cjs",
    "dev": "vite",
    "build": "npm run sitemap:generate && tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "fix": "npm run lint -- --fix && npm run format",
    "preview": "vite preview",
    "pretest": "node scripts/check-node-version.cjs",
    "test": "vitest run && npm run test:functions && npm run test:i18n && npm run test:lint-baseline",
    "test:functions": "node --test tests/netlify-functions/*.test.mjs",
    "test:i18n": "node --test tests/i18n/*.test.cjs",
    "test:lint-baseline": "node --test tests/lint/*.test.mjs",
    "fonts:generate-info": "node scripts/generate-font-info.mjs",
    "pdf:render": "RENDER_THEME=${RENDER_THEME:?set RENDER_THEME=<themeId>, optionally RENDER_FIXTURE=single|placeholder} vitest run src/components/preview/__tests__/renderThemePdf.test.ts",
    "test:watch": "vitest",
    "prepare": "husky",
    "sitemap:generate": "node scripts/generate-sitemap.cjs",
    "sitemap:generate:update-dates": "node scripts/generate-sitemap.cjs --update-sitemap-dates",
    "changelog:sync": "node scripts/sync-changelog.cjs",
    "changelog:add": "node scripts/add-changelog.cjs",
    "changelog:deps": "node scripts/changelog-deps.cjs",
    "model:snapshot": "node scripts/model-snapshot.cjs",
    "i18n:sync": "node scripts/sync-modular-translations.cjs",
    "i18n:sort": "node scripts/sort-locales.cjs",
    "i18n:check": "node scripts/check-i18n.cjs",
    "i18n:literals": "node scripts/find-bare-literals.cjs",
    "i18n:handoff:generate": "node scripts/generate-i18n-handoff.cjs",
    "i18n:handoff:import": "node scripts/import-i18n-handoff.cjs",
    "ai:check-sync": "node scripts/check-ai-constants-sync.cjs",
    "brand:check": "node scripts/check-brand-migration.cjs",
    "release": "node scripts/release.cjs",
    "check-licenses": "node scripts/check-licenses.cjs && npx prettier --write src/assets/licenses.json",
    "update:minor": "node scripts/update-minor.cjs"
  },
  "dependencies": {
    "@daypicker/react": "^10.0.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@myriaddreamin/typst-ts-renderer": "^0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "^0.7.0",
    "@myriaddreamin/typst.ts": "^0.7.0",
    "@octokit/rest": "^22.0.1",
    "@radix-ui/react-alert-dialog": "^1.1.24",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-popover": "^1.2.0",
    "@sanity/client": "^8.9.0",
    "@sanity/image-url": "^2.1.1",
    "@supabase/supabase-js": "^2.117.3",
    "@types/file-saver": "^2.0.7",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "file-saver": "^2.0.5",
    "heic-to": "^1.6.5",
    "immer": "^11.1.21",
    "jszip": "^3.10.2",
    "lucide-react": "^1.53.0",
    "mammoth": "^1.13.0",
    "posthog-js": "^1.438.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-helmet-async": "^3.0.0",
    "react-icons": "^5.7.0",
    "react-image-crop": "^11.1.2",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^23.0.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "buffer": "^6.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "process": "^0.11.10",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vitest-axe": "^0.1.0"
  }
}
